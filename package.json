{
	"name": "compass-education",
	"version": "2.3.1",
	"description": "Interact with Compass, an online Australian education platform",
	"main": "dist/cjs/index.cjs",
	"module": "dist/esm/index.mjs",
	"types": "dist/cjs/index.d.cts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.mjs"
		},
		"require": {
			"types": "./dist/cjs/index.d.cts",
			"default": "./dist/cjs/index.cjs"
		}
	},
	"scripts": {
		"build": "pnpm tsup",
		"lint": "pnpm oxlint src,tests --fix",
		"format": "pnpm prettier --write \"{src,tests}/**/*.ts\"",
		"test": "pnpm uvu tests -b -i setup -r esbuild-register",
		"prepare": "husky && pnpm build"
	},
	"keywords": [
		"compass",
		"compass-education",
		"scraper"
	],
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=18",
		"pnpm": ">=10"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heheleo/compass-education.git"
	},
	"bugs": {
		"url": "https://github.com/heheleo/compass-education/issues"
	},
	"type": "module",
	"author": "heheleo",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/node": "^22.15.32",
		"@types/user-agents": "^1.0.4",
		"dotenv": "^16.5.0",
		"esbuild-register": "^3.6.0",
		"husky": "^9.1.7",
		"oxlint": "^0.15.15",
		"prettier": "^3.6.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"uvu": "^0.5.6"
	},
	"dependencies": {
		"puppeteer": "^24.10.2",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"puppeteer"
		]
	}
}
